# Copy to ~/.env.grabstack-social (outside the repo — never commit real keys).
# A platform with no credentials here is skipped, so you can set these up one
# at a time and the publisher stays happy.

# --- Bluesky ---------------------------------------------------------------
# Create an APP PASSWORD (Settings > Privacy and security > App passwords).
# Never the account password.
BLUESKY_HANDLE=grabstack.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Mastodon --------------------------------------------------------------
# Instance > Preferences > Development > New application, scope: write:statuses
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TOKEN=

# --- X -------------------------------------------------------------------
# A NEW GrabStack developer app, OAuth 1.0a, with Read and Write permission.
# Do not reuse the @mirrorroot keys in ~/.env.x_api — that account belongs to
# Pentagon Physics and its posting is deliberately paused.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
