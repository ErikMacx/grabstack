---
const navLinks = [
  { label: "Frontier", href: "/frontier" },
  { label: "Landscape", href: "/landscape" },
  { label: "The Wire", href: "/wire" },
  { label: "Apps", href: "/apps" },
  { label: "Stacks", href: "/stacks" },
  { label: "Learning", href: "/learning" },
];

const utilityLinks = [
  { label: "About", href: "/about" },
  { label: "Glossary", href: "/glossary" },
];

const currentPath = Astro.url.pathname;

// GrabStack Resources is a separate section (independent UK analysis and free
// strategy tools), so it is styled in its own navy-and-mint colours rather
// than as one of the AI-guide links.
const resources = {
  href: "https://resources.grabstack.com/",
  title: "GrabStack Resources: independent UK analysis and free strategy tools, separate from the AI tools guide",
};
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/95 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
    <!-- Logo -->
    <a href="/" aria-label="GrabStack home" class="shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 372 96" role="img" aria-label="GrabStack" class="h-8 w-auto sm:h-9">
        <g transform="translate(2 4) scale(0.92)">
          <path d="M30 18 H16 V78 H30" fill="none" stroke="#F7F4EE" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M66 18 H80 V78 H66" fill="none" stroke="#F7F4EE" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="30" y="56" width="36" height="11" rx="5.5" fill="#F7F4EE"/>
          <rect x="30" y="42" width="36" height="11" rx="5.5" fill="#F7F4EE"/>
          <rect x="32" y="24" width="36" height="11" rx="5.5" fill="#FF5A36" transform="rotate(-7 50 29.5)"/>
        </g>
        <text x="104" y="62" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="47" letter-spacing="-1.8">
          <tspan fill="#F7F4EE" font-weight="500">Grab</tspan><tspan fill="#F7F4EE" font-weight="800">Stack</tspan><tspan fill="#FF5A36" font-weight="800">.</tspan>
        </text>
      </svg>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-4 lg:flex">
      <ul class="flex items-center gap-1">
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                "font-sans rounded-md px-3 py-1.5 text-sm font-medium transition-colors",
                currentPath.startsWith(href)
                  ? "text-accent"
                  : "text-paper/70 hover:text-paper",
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <span class="h-4 w-px bg-white/15"></span>
      {utilityLinks.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            "font-sans text-xs font-medium transition-colors",
            currentPath.startsWith(href)
              ? "text-accent"
              : "text-muted hover:text-paper",
          ]}
        >
          {label}
        </a>
      ))}
      <span class="h-4 w-px bg-white/15"></span>
      <a
        href={resources.href}
        title={resources.title}
        class="font-sans inline-flex items-center gap-2 rounded-full border border-[#5fd3a8]/55 bg-[#102a43] px-3 py-1.5 text-xs font-semibold text-[#5fd3a8] transition-colors hover:border-[#5fd3a8] hover:bg-[#163a5c]"
      >
        <svg aria-hidden="true" viewBox="0 0 32 32" class="h-4 w-4 shrink-0"><rect width="32" height="32" rx="8" fill="#5fd3a8"/><rect x="7" y="8" width="18" height="4" rx="2" fill="#102a43"/><rect x="7" y="14" width="18" height="4" rx="2" fill="#102a43" opacity=".7"/><rect x="7" y="20" width="18" height="4" rx="2" fill="#f5b841"/></svg>
        Resources
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      class="rounded-md p-2 text-paper/70 hover:text-paper lg:hidden"
    >
      <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-white/10 lg:hidden">
    <ul class="mx-auto max-w-6xl space-y-1 px-5 py-4">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class:list={[
              "font-sans block rounded-md px-3 py-2 text-base font-medium transition-colors",
              currentPath.startsWith(href)
                ? "text-accent"
                : "text-paper/70 hover:text-paper",
            ]}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="border-t border-white/10 pt-2 mt-2">
        {utilityLinks.map(({ label, href }) => (
          <a
            href={href}
            class:list={[
              "font-sans block rounded-md px-3 py-2 text-sm font-medium transition-colors",
              currentPath.startsWith(href)
                ? "text-accent"
                : "text-muted hover:text-paper",
            ]}
          >
            {label}
          </a>
        ))}
      </li>
      <li class="border-t border-white/10 pt-3 mt-2">
        <a
          href={resources.href}
          class="font-sans flex items-center gap-3 rounded-lg border border-[#5fd3a8]/40 bg-[#102a43] px-3 py-3 transition-colors hover:border-[#5fd3a8]"
        >
          <svg aria-hidden="true" viewBox="0 0 32 32" class="h-6 w-6 shrink-0"><rect width="32" height="32" rx="8" fill="#5fd3a8"/><rect x="7" y="8" width="18" height="4" rx="2" fill="#102a43"/><rect x="7" y="14" width="18" height="4" rx="2" fill="#102a43" opacity=".7"/><rect x="7" y="20" width="18" height="4" rx="2" fill="#f5b841"/></svg>
          <span class="flex flex-col">
            <span class="text-sm font-semibold text-[#5fd3a8]">GrabStack Resources ↗</span>
            <span class="text-xs text-[#c3d2e3]">Independent UK analysis and free strategy tools</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const iconOpen = document.getElementById("icon-open")!;
  const iconClose = document.getElementById("icon-close")!;

  toggle.addEventListener("click", () => {
    const open = menu.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!open));
    iconOpen.classList.toggle("hidden");
    iconClose.classList.toggle("hidden");
  });
</script>
