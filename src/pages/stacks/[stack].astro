---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const stacks = await getCollection("stacks");
  return stacks.map((entry) => ({
    params: { stack: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} — Stacks — GrabStack`}
  description={entry.data.summary}
>
  <section class="py-6 sm:py-10">
    <p class="font-mono text-xs text-muted">
      <a href="/stacks" class="text-accent hover:underline">Stacks</a> ›
    </p>
    <h1 class="font-sans mt-2 text-2xl font-bold tracking-tight sm:text-4xl">
      {entry.data.title}<span class="text-accent">.</span>
    </h1>
    <p class="mt-2 max-w-xl text-base text-muted italic">
      {entry.data.profession}
    </p>
  </section>

  <div class="max-w-3xl rounded-lg border border-white/10 bg-surface p-6">
    <div class="prose-invert prose max-w-none text-paper/80 leading-relaxed [&_h2]:font-sans [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-paper [&_h2]:mt-6 [&_h2]:mb-2 [&_p]:text-base [&_p]:text-paper/80">
      <Content />
    </div>
    <div class="mt-6 pt-4 border-t border-white/10 flex gap-4 font-mono text-xs text-muted">
      <span>Updated {entry.data.updated}</span>
      <span>·</span>
      <span>Review by {entry.data.reviewed}</span>
    </div>
  </div>
</Base>
