---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { REGION_STATUSES, STATUS_DEFINITIONS } from "../lib/constants";
import landscapeData from "../data/ai-landscape.json";

const allTools = await getCollection("tools");
const allUpdates = await getCollection("updates");

// Landscape: top 3 debates by overall score
const topDebates = [...landscapeData.debates]
  .sort((a, b) => b.scores.overall - a.scores.overall)
  .slice(0, 3);

// Frontier: first 6 tools by status weight
const frontierTools = allTools
  .filter((t) => ["flagship", "top-ranked", "category-leader"].includes(t.data.status))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .slice(0, 6);

// Wire: latest 3
const wireEntries = allUpdates
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// Apps count
const appsCount = allTools.length;

// Stacks
const allStacks = await getCollection("stacks");
const stacksCount = allStacks.length;

// Top 3 apps by status weight for teaser
const topApps = allTools
  .filter((t) => t.data.status === "flagship" || t.data.status === "top-ranked")
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .slice(0, 6);

const battlegrounds: Record<string, string> = landscapeData.battlegrounds;
---

<Base>
  <!-- Hero -->
  <section class="py-14 sm:py-24 text-center">
    <a href="/" aria-label="GrabStack home" class="inline-block">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 372 96" role="img" aria-label="GrabStack" class="mx-auto h-12 w-auto sm:h-16">
        <g transform="translate(2 4) scale(0.92)">
          <path d="M30 18 H16 V78 H30" fill="none" stroke="#ECE8E0" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M66 18 H80 V78 H66" fill="none" stroke="#ECE8E0" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="30" y="56" width="36" height="11" rx="5.5" fill="#ECE8E0"/>
          <rect x="30" y="42" width="36" height="11" rx="5.5" fill="#ECE8E0"/>
          <rect x="32" y="24" width="36" height="11" rx="5.5" fill="#FF5A36" transform="rotate(-7 50 29.5)"/>
        </g>
        <text x="104" y="62" font-family="'Inter', 'Helvetica Neue', sans-serif" font-size="47" letter-spacing="-1.8">
          <tspan fill="#ECE8E0" font-weight="500">Grab</tspan><tspan fill="#ECE8E0" font-weight="800">Stack</tspan><tspan fill="#FF5A36" font-weight="800">.</tspan>
        </text>
      </svg>
    </a>
    <p class="font-sans mt-2 text-sm font-medium uppercase tracking-[.15em] text-muted">
      Signal, not noise
    </p>
    <p class="mt-4 font-sans text-xl text-paper sm:text-2xl font-medium">
      The AI world, made legible<span class="text-accent">.</span>
    </p>
  </section>

  <!-- Frontier teaser -->
  {frontierTools.length > 0 && (
    <section class="mb-14">
      <div class="flex items-baseline justify-between">
        <h2 class="font-sans text-lg font-semibold text-paper">Frontier</h2>
        <a href="/frontier" class="font-sans text-sm text-accent hover:underline">Full frontier →</a>
      </div>
      <p class="mt-1 text-base text-muted">The live edge — what's cutting edge right now.</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {frontierTools.map((t) => (
          <div class="rounded-lg border border-white/10 bg-surface p-4">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h3 class="font-sans text-sm font-semibold text-paper">{t.data.name}</h3>
                <p class="font-mono text-xs text-muted">{t.data.maker}</p>
              </div>
              <span
                class:list={[
                  "shrink-0 rounded-full px-2 py-0.5 font-mono text-xs font-semibold leading-tight",
                  t.data.status === "flagship" ? "border-2 border-accent text-accent font-bold" : "border border-accent text-accent",
                ]}
              >
                {STATUS_DEFINITIONS[t.data.status]?.label ?? t.data.status}
              </span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-paper/80">{t.data.claim}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Landscape teaser: top 3 debates -->
  <section class="mb-14">
    <div class="flex items-baseline justify-between">
      <h2 class="font-sans text-lg font-semibold text-paper">The Landscape</h2>
      <a href="/landscape" class="font-sans text-sm text-accent hover:underline">All 16 debates →</a>
    </div>
    <p class="mt-1 text-base text-muted">The forces shaping AI — ranked by Overall importance.</p>
    <div class="mt-4 space-y-2">
      {topDebates.map((d, i) => (
        <a href="/landscape" class="group flex items-start gap-3 rounded-lg border border-white/[.08] bg-surface px-4 py-3 transition-colors hover:border-white/20">
          <span class="font-sans text-accent text-2xl font-extrabold leading-none tabular-nums min-w-[2ch] text-right select-none">
            {i + 1}
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <h3 class="font-sans text-base font-bold text-paper leading-snug group-hover:text-accent transition-colors">
                {d.title}
              </h3>
              <span class="font-mono rounded bg-white/[.08] px-1.5 py-[1px] text-xs font-medium text-muted">
                {battlegrounds[d.bg]}
              </span>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-paper/70 line-clamp-1">
              {d.tension}
            </p>
            <div class="mt-2 flex items-center gap-3">
              <div class="h-[4px] flex-1 rounded-full bg-white/[.08] overflow-hidden">
                <div class="h-full rounded-full bg-accent" style={`width:${d.scores.overall}%`} />
              </div>
              <span class="font-mono text-accent text-sm font-bold tabular-nums w-7 text-right">
                {d.scores.overall}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- From The Wire -->
  {wireEntries.length > 0 && (
    <section class="mb-14">
      <div class="flex items-baseline justify-between">
        <h2 class="font-sans text-lg font-semibold text-paper">From The Wire</h2>
        <a href="/wire" class="font-sans text-sm text-accent hover:underline">All dispatches →</a>
      </div>
      <div class="mt-4 space-y-3">
        {wireEntries.map((entry) => (
          <article class="rounded-lg border border-white/10 bg-surface p-4">
            <h3 class="font-sans text-sm font-semibold text-paper">{entry.data.title}</h3>
            <p class="font-mono mt-1 text-xs text-muted">
              Posted {entry.data.date} · Review by {entry.data.reviewBy}
            </p>
            <p class="mt-2 text-sm text-paper/80">{entry.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Apps teaser -->
  <section class="mb-14">
    <div class="flex items-baseline justify-between">
      <h2 class="font-sans text-lg font-semibold text-paper">Apps</h2>
      <a href="/apps" class="font-sans text-sm text-accent hover:underline">All {appsCount} apps →</a>
    </div>
    <p class="mt-1 text-base text-muted">The full, searchable list of every major AI application.</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {topApps.map((t) => (
        <div class="rounded-lg border border-white/10 bg-surface p-4">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h3 class="font-sans text-sm font-semibold text-paper">{t.data.name}</h3>
              <p class="font-mono text-xs text-muted">{t.data.maker}</p>
            </div>
            <span
              class:list={[
                "shrink-0 rounded-full px-2 py-0.5 font-mono text-xs font-semibold leading-tight",
                t.data.status === "flagship" ? "border-2 border-accent text-accent font-bold" : "border border-accent text-accent",
              ]}
            >
              {STATUS_DEFINITIONS[t.data.status]?.label ?? t.data.status}
            </span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-paper/80">{t.data.claim}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Stacks teaser -->
  <section class="mb-14">
    <div class="flex items-baseline justify-between">
      <h2 class="font-sans text-lg font-semibold text-paper">Stacks</h2>
      <a href="/stacks" class="font-sans text-sm text-accent hover:underline">All {stacksCount} stacks →</a>
    </div>
    <p class="mt-1 text-base text-muted">Tool combinations that work together — curated by profession and industry.</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {allStacks.slice(0, 3).map((s) => (
        <a href={`/stacks/${s.slug}`} class="group rounded-lg border border-white/10 bg-surface p-4 transition-colors hover:border-white/20">
          <h3 class="font-sans text-sm font-semibold text-paper group-hover:text-accent transition-colors">{s.data.title}</h3>
          <p class="font-mono text-xs text-muted mt-1">{s.data.profession}</p>
          {s.data.summary && (
            <p class="mt-2 text-sm leading-relaxed text-paper/80 line-clamp-2">{s.data.summary}</p>
          )}
        </a>
      ))}
    </div>
  </section>

  <!-- Learning teaser -->
  <section class="mb-14">
    <div class="flex items-baseline justify-between">
      <h2 class="font-sans text-lg font-semibold text-paper">Learning</h2>
      <a href="/learning" class="font-sans text-sm text-accent hover:underline">All learning →</a>
    </div>
    <p class="mt-1 text-base text-muted">What to learn, and in what order — courses, programmes and concepts mapped to the competency you need.</p>
  </section>

  <!-- Curated by -->
  <section class="mb-8 text-center">
    <p class="font-sans text-sm text-muted">
      Curated by <a href="/about" class="text-paper hover:text-accent transition-colors font-medium">Eric McLean</a>
    </p>
  </section>
</Base>
