            </tr>
            <tr>
              <td class="px-3 py-2 text-paper">CrewAI / LangGraph</td>
              <td class="px-3 py-2">Configurable</td>
              <td class="px-3 py-2">Configurable</td>
              <td class="px-3 py-2">Iterative</td>
              <td class="px-3 py-2">Tools & APIs</td>
              <td class="px-3 py-2">Configurable</td>
