---
import Base from "../../layouts/Base.astro";
import { ACCESS_LADDER } from "../../lib/constants";
---

<Base title="Agent Taxonomy — Learning — GrabStack" description="A faceted taxonomy of AI agents — types, access levels, and how they differ.">
  <section class="py-6 sm:py-10">
    <h1 class="text-2xl font-bold tracking-tight sm:text-4xl">
      Agent Taxonomy<span class="text-accent">.</span>
    </h1>
    <p class="mt-2 max-w-xl text-sm text-muted">
      A faceted taxonomy of AI agents — content to follow.
    </p>
    <p class="mt-1 text-xs text-muted">
      Part of <a href="/learning" class="text-accent hover:underline">Learning</a>.
    </p>
  </section>

  <!-- Access ladder (moved from Terrain) -->
  <section class="mb-12">
    <h2 class="text-lg font-semibold text-paper">Types of AI access</h2>
    <p class="mt-1 text-sm text-muted">From simplest to most autonomous — the ladder of what AI can do for you.</p>
    <div class="mt-4 space-y-3">
      {ACCESS_LADDER.map((level, i) => (
        <div id={level.slug} class="scroll-mt-24 rounded-lg border border-white/10 bg-surface p-4">
          <div class="flex items-baseline gap-3">
            <span class="text-xs font-bold text-accent">{i + 1}</span>
            <h3 class="text-sm font-semibold text-paper">{level.term}</h3>
          </div>
          <p class="mt-1 text-sm text-paper/80">
            {level.definition.replace(/<!--.*?-->/g, "").trim()}
          </p>
        </div>
      ))}
    </div>
  </section>
</Base>
