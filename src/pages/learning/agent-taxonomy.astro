            </tr>
            <tr class="border-b border-white/[.06]">
              <td class="px-3 py-2 text-paper">Computer-use agents</td>
              <td class="px-3 py-2">Agent → Auto</td>
              <td class="px-3 py-2">Reactive</td>
              <td class="px-3 py-2">Iterative</td>
              <td class="px-3 py-2">Apps & computer</td>
