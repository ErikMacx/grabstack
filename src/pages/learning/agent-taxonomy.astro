              <th class="font-sans px-3 py-2 text-left font-semibold text-paper">Initiative</th>
              <th class="font-sans px-3 py-2 text-left font-semibold text-paper">Loop</th>
              <th class="font-sans px-3 py-2 text-left font-semibold text-paper">Reach</th>
              <th class="font-sans px-3 py-2 text-left font-semibold text-paper">Scope</th>
              <th class="font-sans px-3 py-2 text-left font-semibold text-paper">Social</th>
            </tr>
