---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const allStacks = await getCollection("stacks");
const stacks = allStacks.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base title="Stacks — GrabStack" description="Tool combinations that work together — curated by profession and industry.">
  <section class="py-6 sm:py-10">
    <h1 class="font-sans text-2xl font-bold tracking-tight sm:text-4xl">
      Stacks<span class="text-accent">.</span>
    </h1>
    <p class="mt-2 max-w-xl text-base text-muted">
      Tool combinations that work together — curated by profession and industry.
    </p>
  </section>

  <p class="mb-6 text-sm text-muted font-mono">{stacks.length} stacks</p>

  <div class="grid gap-3 sm:grid-cols-2">
    {stacks.map((s) => (
      <a href={`/stacks/${s.id}`} class="group rounded-lg border border-white/10 bg-surface p-5 transition-colors hover:border-white/20">
        <h3 class="font-sans text-base font-semibold text-paper group-hover:text-accent transition-colors">{s.data.title}</h3>
        <p class="mt-1 text-sm text-muted italic">{s.data.profession}</p>
        <p class="mt-2 text-sm leading-relaxed text-paper/80">{s.data.summary}</p>
        <p class="mt-2 font-mono text-xs text-muted">Updated {s.data.updated}</p>
      </a>
    ))}
  </div>
</Base>
