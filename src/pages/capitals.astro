---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { REGION_STATUSES } from "../lib/constants";
import { STATUS_DEFINITIONS, appendRef } from "../lib/constants";

const allTools = await getCollection("tools");
const tools = allTools
  .filter((t) => (REGION_STATUSES.capitals as readonly string[]).includes(t.data.status))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base title="The Capitals — GrabStack" description="The key players — the dominant labs and flagship models.">
  <section class="py-6 sm:py-10">
    <h1 class="font-sans text-2xl font-bold tracking-tight sm:text-4xl">
      The Capitals<span class="text-accent">.</span>
    </h1>
    <p class="mt-2 max-w-xl text-base text-muted">
      The key players — the dominant labs and flagship models.
    </p>
  </section>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map((t) => (
      <div class="rounded-lg border border-white/10 bg-surface p-4">
        <div class="flex items-start justify-between gap-2">
          <div>
            <h3 class="text-sm font-semibold text-paper">{t.data.name}</h3>
            <p class="text-xs text-muted">{t.data.maker}</p>
          </div>
          <a
            href={`/about#methodology`}
            title={STATUS_DEFINITIONS[t.data.status]?.definition.replace(/<!--.*?-->/g, "").trim() ?? ""}
            class:list={[
              "status-tooltip shrink-0 rounded-full px-2 py-0.5 font-mono text-xs font-semibold leading-tight no-underline",
              t.data.status === "flagship" ? "border-2 border-accent text-accent font-bold" : "border border-accent text-accent",
            ]}
            data-tooltip={STATUS_DEFINITIONS[t.data.status]?.definition.replace(/<!--.*?-->/g, "").trim() ?? ""}
          >
            {STATUS_DEFINITIONS[t.data.status]?.label ?? t.data.status}
          </a>
        </div>
        <p class="mt-2 text-xs leading-relaxed text-paper/80">{t.data.claim}</p>
        <div class="mt-2 font-mono text-xs text-muted">
          Updated {t.data.updated} · Review by {t.data.reviewed}
        </div>
        {t.data.source && (
          <a
            href={appendRef(t.data.source)}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-block text-xs text-accent hover:underline"
          >
            Source →
          </a>
        )}
      </div>
    ))}
  </div>
</Base>
