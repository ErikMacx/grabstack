---
import Base from "../layouts/Base.astro";
---

<Base title="Routes — GrabStack" description="Stacks by job — tool combinations that work together.">
  <section class="py-6 sm:py-10">
    <h1 class="text-2xl font-bold tracking-tight sm:text-4xl">
      Routes<span class="text-accent">.</span>
    </h1>
    <p class="mt-2 max-w-xl text-sm text-muted">
      Stacks by job — tool combinations that work together.
    </p>
  </section>

  <div class="rounded-lg border border-white/10 bg-surface p-6">
    <p class="text-sm leading-relaxed text-paper/80">
      Routes are curated tool stacks built for specific jobs — what an estate agent actually uses,
      what a solo dev ships with, what a marketing team runs on. Each route names the tools,
      explains why they fit together, and carries a date so you know it's current.
    </p>
    <p class="mt-4 text-sm text-muted">
      We're assembling the first routes now. Check <a href="/wire" class="text-accent hover:underline">The Wire</a> for updates.
    </p>
  </div>
</Base>
